{
  "manifest_version": 3,
  "name": "aflow",
  "version": "0.2.0",
  "description": "DRR 자동화 엔진 — DRR 문서를 DSL로 변환하고 브라우저에서 실행합니다.",
  "permissions": ["debugger", "activeTab", "storage", "tabs", "tabCapture", "sidePanel"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://*.lgudax.cool/*",
    "http://digitalplatform-iop.cloud/*",
    "https://digitalplatform-iop.cloud/*"
  ],
  "action": {
    "default_title": "aflow"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/Icon.png",
    "48": "icons/Icon.png",
    "128": "icons/Icon.png"
  }
}
